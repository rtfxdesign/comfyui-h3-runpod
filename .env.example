# ============================================================================
#  Copy this file to  .env  and paste your keys below.
#
#  .env is gitignored and never copied into the image (.dockerignore), so it
#  stays local. On RunPod, do NOT ship a .env — set these as pod Environment
#  Variables in the pod config instead.
#
#  NOTE: if this repo lives in a cloud-synced folder (OneDrive, Dropbox,
#  iCloud), a .env here syncs to the cloud too. Keep real keys out of synced
#  folders — use RunPod's env vars, or move the repo somewhere local first.
# ============================================================================


# ---- PASTE YOUR KEYS HERE --------------------------------------------------

# HuggingFace — needed for gated/private repos.
# Create at https://huggingface.co/settings/tokens  (read scope is enough)
HF_TOKEN=

# CivitAI — required for ANY civitai.com URL in models.conf. Without it those
# downloads return 401 and provisioning logs an error for each.
# Create at https://civitai.com/user/account
CIVITAI_API_TOKEN=
# (CIVITAI_TOKEN is accepted too, if that is the name you already use.)

# ----------------------------------------------------------------------------


# ---- Optional -------------------------------------------------------------

# Change the model set WITHOUT rebuilding the image. Point these at the RAW
# GitHub URLs of your config files; if set, they override the baked-in copies
# at boot. This is the main reason provisioning happens at start rather than
# in a Docker layer.
# PROVISION_CONFIG_URL=https://raw.githubusercontent.com/<user>/<repo>/main/config/models.conf
# PROVISION_NODES_URL=https://raw.githubusercontent.com/<user>/<repo>/main/config/nodes.conf

# PRIVATE repo? Raw URLs 404 without auth. Set this to a GitHub fine-grained
# PAT with Contents: Read-only on the repo. It is sent ONLY to github.com /
# raw.githubusercontent.com, never to other hosts.
# GH_CONFIG_TOKEN=

# ---- GPU tier (which model precision to download) --------------------------
# auto (default) picks by the GPU's VRAM. Or force one:
#   16  16-23 GB  same files as the home PC (int8 models, nvfp4 text encoder)  ~122 GB download
#   24  24-47 GB  int8 models, int8 text encoder, fp16 video VAE               ~140 GB
#   48  48-79 GB  + bf16 image model                                           ~159 GB
#   80  80-92 GB  everything bf16, int8 text encoder                           ~226 GB
#   96  93 GB+    everything bf16 incl. bf16 text encoder                      ~251 GB
#   none          only models.conf + H3_MODEL_PROFILES (old behaviour)
H3_TIER=auto

# --highvram: auto = only on GPUs with >= 140 GB (H200, B200). 1 = on, 0 = off.
H3_HIGHVRAM=auto

# 0 = do not start ComfyUI-Manager (--enable-manager).
H3_ENABLE_MANAGER=1

# H3 Image LoRAs from config/image_loras.conf (CivitAI; needs CIVITAI_API_TOKEN),
# saved to models/loras/H3-Image/.  default | all | none | comma list.
H3_IMAGE_LORAS=default

# ---- Model profiles & LoRA catalog -----------------------------------------

# Extra model sets for the official templates in workflows/official/.
# Comma list of config/profiles/<name>.conf. Empty = only models.conf.
#   (official-ref2v, official-fl2v, controlnet: only needed with H3_TIER=none —
#    every tier already includes those files)
#   fasth3          FastVideo FastH3 8-step distilled checkpoints (no turbo LoRA)
#   pika-flex       Pika H3 Flex adapters (needs ComfyUI 0.44.0)
H3_MODEL_PROFILES=

# Adult LoRAs from config/adult_loras.conf (CivitAI; needs CIVITAI_API_TOKEN).
#   default  six small adapters marked default=yes   (used when unset)
#   all      every catalog entry
#   none     nothing
#   or a comma list of keys / version ids, e.g. default,pov_doggy,3405852
# Downloading does not enable them in any workflow.
H3_ADULT_LORAS=default

# Optional raw-URL override for the adult catalog (same rules as above).
# PROVISION_ADULT_LORAS_URL=

# 1 = move existing custom-node clones onto the refs pinned in nodes.conf.
NODES_SYNC_PINS=0

# 1 = install ComfyUI-H3-Motion-Context v0.7.1 (see scripts/install-motion-context.sh
#     — it does NOT fix Multishot's context_pin; use continuity=first_frame).
H3_INSTALL_MOTION_CONTEXT=0

# 1 = copy the JoyEcho writer pack shipped inside ComfyUI-H3-Multishot into
#     custom_nodes (requirements are NOT auto-installed).
H3_INSTALL_WRITER_PACK=0

# 1 = print the provisioning plan only (no clone/download/write).
DRY_RUN=0

# 1 = boot straight into ComfyUI with no downloads. Useful for debugging a pod
# whose models are already on the volume.
SKIP_PROVISION=0

# Extra ComfyUI launch flags:
#   --disable-dynamic-vram fixes "VBAR MemoryError" in TextGenerateV2 (seen on
#                          the home PC); add --disable-pinned-memory if needed
#   --lowvram              aggressive offload, for cards under ~16 GB
#   --use-sage-attention   faster attention, if sageattention is installed
COMFY_EXTRA_ARGS=

# Listen port. Must match the HTTP port you expose on the pod.
COMFY_PORT=8188

# JupyterLab file manager on port 8888 (upload LoRAs, download outputs).
# Set a password to ENABLE it — unset = Jupyter does not start at all.
# This becomes the login token you type at the Jupyter page.
JUPYTER_PASSWORD=
