# Shell scripts and config read INSIDE the Linux container must stay LF.
# A CRLF checkout on Windows breaks the shebang ("/usr/bin/env bash\r:
# no such file or directory") and silently corrupts conf parsing.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yml       text eol=lf
.env.example text eol=lf

# Workflow JSON is data, not source — leave it byte-for-byte alone.
*.json      -text
